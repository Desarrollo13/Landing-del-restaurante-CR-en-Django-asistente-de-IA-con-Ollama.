# Copia este archivo como .env y rellena los valores reales.
# NO subas nunca tu .env al repositorio.

# Django
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=*
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Base de datos (opcional en local; si se omite se usa SQLite)
# DATABASE_URL=postgres://usuario:password@host:5432/nombre

# Asistente IA (Ollama / túnel)
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_AUTH_USER=
OLLAMA_AUTH_PASS=

# Superusuario creado/actualizado con `python manage.py crear_admin`
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cargar datos de demostración en el build (1 = sí, 0 = no)
CARGAR_DEMO=0
